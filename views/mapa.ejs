<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Garantiza que el lienzo del gráfico se estire dentro de su contenedor */
        #chartContainer {
            height: 400px; /* Altura fija para la visualización */
            width: 100%;
        }
    </style>
    <!-- Carga la librería Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    
</head>
<body class="bg-gray-50 min-h-screen p-4 md:p-8">

    <!-- Contenedor Principal -->
    <main class="max-w-4xl mx-auto bg-white p-6 md:p-10 rounded-xl shadow-2xl space-y-8">
        <header class="text-center border-b pb-4">
            <h1 class="text-4xl font-extrabold text-indigo-700">
                Tu Habit Map Personalizado
            </h1>
            <p class="text-xl text-gray-600 mt-2">
                ¡Hola, <span class="font-bold text-indigo-500"><%= userId %></span>!
            </p>
            <p class="text-sm text-gray-400 mt-1">
                (Datos basados en <%= totalParticipants %> participantes en total)
            </p>
        </header>

        <!-- Sección de Visualización (10 pts) -->
        <section class="bg-white p-4 rounded-lg border border-gray-100">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4 text-center">
                Comparación de Hábitos (Tú vs. Comunidad)
            </h2>
            <!-- Contenedor del Gráfico -->
            <div id="chartContainer" class="relative">
                <canvas id="habitMapChart"></canvas>
            </div>
        </section>

        <!-- Storytelling y Análisis (10 pts) -->
        <section class="space-y-4 pt-4 border-t border-gray-100">
            <h2 class="text-2xl font-bold text-gray-800">
                Tu Historia de Hábitos
            </h2>
            
            <%
                // Lógica simple para el Storytelling
                let peakMsg, intensityMsg, interruptionsMsg;

                // 1. Análisis de Hora Pico
                if (userHabit.peak_hour < communityAvg.peak_hour - 2) {
                    peakMsg = 'Eres un/a **madrugador/a extremo**.';
                } else if (userHabit.peak_hour > communityAvg.peak_hour + 2) {
                    peakMsg = 'Muestras un patrón de **búho nocturno**.';
                } else {
                    peakMsg = 'Tu hora pico está **alineada con la mayoría** de la comunidad.';
                }

                // 2. Análisis de Intensidad
                if (userHabit.intensity_score > communityAvg.intensity_score + 10) {
                    intensityMsg = 'Tienes un **ritmo de vida muy alto** (Intensidad: ' + userHabit.intensity_score + ').';
                } else if (userHabit.intensity_score < communityAvg.intensity_score - 10) {
                    intensityMsg = 'Pareces llevar un **ritmo más tranquilo y bajo** (Intensidad: ' + userHabit.intensity_score + ').';
                } else {
                    intensityMsg = 'Tu intensidad diaria es **similar al promedio** (' + communityAvg.intensity_score + ').';
                }

                // 3. Análisis de Interrupciones
                if (userHabit.interruptions > communityAvg.interruptions + 2) {
                    interruptionsMsg = 'Experimentas **muchas más interrupciones** que la media. Priorizar el enfoque podría ser clave.';
                } else if (userHabit.interruptions < communityAvg.interruptions - 2) {
                    interruptionsMsg = '¡Excelente! Eres **muy bueno/a manteniendo el foco**, con pocas interrupciones.';
                } else {
                    interruptionsMsg = 'El nivel de interrupciones que manejas es **típico de la comunidad**.';
                }
            %>
            
            <p class="text-lg text-gray-700 leading-relaxed">
                El gráfico de radar muestra cómo se compara tu <span class="font-semibold text-indigo-600">forma de vida natural</span> con el promedio de otros participantes.
            </p>

            <ul class="list-disc list-inside space-y-3 ml-4 text-gray-700">
                <li><strong class="text-indigo-600">Energía:</strong> <%= peakMsg %> (Comunidad promedio: <%= communityAvg.peak_hour %>:00).</li>
                <li><strong class="text-green-600">Actividad:</strong> <%= intensityMsg %> (Comunidad promedio: <%= communityAvg.intensity_score %>).</li>
                <li><strong class="text-red-600">Foco:</strong> <%= interruptionsMsg %> (Comunidad promedio: <%= communityAvg.interruptions %> interrupciones).</li>
            </ul>

            <p class="text-sm text-gray-500 pt-4 italic">
                <a href="/start" class="text-indigo-500 hover:underline">Volver a la Introducción</a> | Proyecto "Your Habit Map".
            </p>
        </section>

        <!-- Datos Ocultos (Necesarios para Chart.js) -->
        <!-- Inyectamos los datos del servidor a través de EJS en elementos ocultos -->
        <script id="user-data" type="application/json">
            <%= JSON.stringify(userHabit) %>
        </script>
        <script id="community-data" type="application/json">
            <%= JSON.stringify(communityAvg) %>
        </script>

    </main>
    
    <!-- Carga el script de configuración de Chart.js -->
    <script src="/js/chartConfig.js"></script>
</body>
</html>