<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <!-- Carga de Tailwind CSS para el estilo -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Carga de la librería Chart.js para dibujar los gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f4f8;
        }
        .container-card {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        #comparisonChart {
            height: 400px; /* Define una altura para el gráfico */
        }
    </style>
</head>
<body class="p-8 md:p-12">

    <div class="max-w-4xl mx-auto bg-white p-6 md:p-10 rounded-xl container-card">

        <h1 class="text-4xl font-bold text-center text-indigo-700 mb-2">Your Personalized Habit Map</h1>
        <p class="text-center text-gray-600 mb-8">Hello, <span class="font-semibold text-indigo-600"><%= userId %></span>!</p>
        <p class="text-center text-sm text-gray-500 mb-10">(Data based on <%= totalParticipants %> total participants)</p>

        <!-- SECCIÓN DE GRÁFICO -->
        <section class="space-y-4 pt-4 border-t border-gray-100">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4 text-center">Habit Comparison (You vs. Community)</h2>
            <div class="bg-gray-50 p-4 rounded-lg shadow-inner">
                <!-- Este es el elemento CANVAS donde Chart.js dibujará el gráfico -->
                <canvas id="comparisonChart"></canvas> 
            </div>
        </section>

        <!-- SECCIÓN DE ANÁLISIS DE TEXTO -->
        <section class="mt-12 space-y-6">
            <h2 class="text-3xl font-bold text-gray-800 mb-4 border-b pb-2">Your Habit Story</h2>

            <% 
                // Variables for easier reading
                const userHabit = locals.userHabit;
                const communityAvg = locals.communityAvg;
                let peakHourMsg = '';
                let intensityMsg = '';
                let interruptionsMsg = '';

                // --- 1. Peak Hour Analysis ---
                if (userHabit.peak_hour < communityAvg.peak_hour - 1) { // 1 hour difference threshold
                    peakHourMsg = `You are significantly more productive in the early hours (around ${userHabit.peak_hour}:00) compared to the community average (${communityAvg.peak_hour}:00). This suggests you might be a "Morning Lark".`;
                } else if (userHabit.peak_hour > communityAvg.peak_hour + 1) {
                    peakHourMsg = `Your peak productivity is later in the day (around ${userHabit.peak_hour}:00) compared to the community average (${communityAvg.peak_hour}:00). This suggests you might be a "Night Owl".`;
                } else {
                    peakHourMsg = `Your peak hour of focus (around ${userHabit.peak_hour}:00) is similar to the community average (${communityAvg.peak_hour}:00).`;
                }

                // --- 2. Intensity Analysis ---
                if (userHabit.intensity_score > communityAvg.intensity_score) {
                    intensityMsg = `You have a very high life pace (${userHabit.intensity_score} vs. ${communityAvg.intensity_score}). You thrive under pressure and maintain focus well.`;
                } else if (userHabit.intensity_score < communityAvg.intensity_score) {
                    intensityMsg = `You seem to have a calmer and lower life pace (${userHabit.intensity_score} vs. ${communityAvg.intensity_score}). This suggests a focus on quality over speed.`;
                } else {
                    intensityMsg = `Your daily intensity is similar to the community average (${userHabit.intensity_score} vs. ${communityAvg.intensity_score}).`;
                }

                // --- 3. Interruptions Analysis ---
                if (userHabit.interruptions > communityAvg.interruptions + 1) {
                    interruptionsMsg = `You experience significantly more interruptions daily (${userHabit.interruptions} vs. ${communityAvg.interruptions} avg.). Focus on blocking time for deep work.`;
                } else if (userHabit.interruptions < communityAvg.interruptions - 1) {
                    interruptionsMsg = `Excellent! You are very good at minimizing distractions (${userHabit.interruptions} vs. ${communityAvg.interruptions} avg.). You maintain high flow states.`;
                } else {
                    interruptionsMsg = `Your level of daily interruptions (${userHabit.interruptions}) is close to the community average (${communityAvg.interruptions}).`;
                }
            %>
            
            <div class="bg-blue-50 p-6 rounded-lg border-l-4 border-blue-500">
                <h3 class="text-xl font-semibold text-blue-800 mb-2">Peak Productivity Hour</h3>
                <p class="text-gray-700"><%= peakHourMsg %></p>
            </div>

            <div class="bg-red-50 p-6 rounded-lg border-l-4 border-red-500">
                <h3 class="text-xl font-semibold text-red-800 mb-2">Life Pace and Intensity</h3>
                <p class="text-gray-700"><%= intensityMsg %></p>
            </div>

            <div class="bg-green-50 p-6 rounded-lg border-l-4 border-green-500">
                <h3 class="text-xl font-semibold text-green-800 mb-2">Distraction Resilience</h3>
                <p class="text-gray-700"><%= interruptionsMsg %></p>
            </div>
            
            <div class="pt-6 text-center">
                <a href="/start" class="inline-block px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg shadow-md hover:bg-indigo-700 transition duration-300">
                    Take the Quiz Again
                </a>
            </div>

        </section>

    </div>

    <!-- 
        Paso 3: Llamar al script de configuración del gráfico
        Esto debe hacerse DESPUÉS de que el elemento <canvas> esté en el DOM.
    -->
    <script src="/javascripts/chartConfig.js"></script>

    <script>
        // Ejecutar la función que dibuja el gráfico cuando la página está cargada
        document.addEventListener('DOMContentLoaded', function() {
            // Pasamos los datos que vienen del servidor (Express)
            const userData = {
                peak_hour: <%= JSON.stringify(userHabit.peak_hour) %>,
                intensity_score: <%= JSON.stringify(userHabit.intensity_score) %>,
                interruptions: <%= JSON.stringify(userHabit.interruptions) %>
            };

            const communityAvg = {
                peak_hour: <%= JSON.stringify(communityAvg.peak_hour) %>,
                intensity_score: <%= JSON.stringify(communityAvg.intensity_score) %>,
                interruptions: <%= JSON.stringify(communityAvg.interruptions) %>
            };
            
            const totalParticipants = <%= JSON.stringify(totalParticipants) %>;

            // Llamar a la función del script chartConfig.js
            createHabitComparisonChart('comparisonChart', userData, communityAvg, totalParticipants);
        });
    </script>

</body>
</html>